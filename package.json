{
  "name": "stretch",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "typecheck": "tsc --noEmit",
    "test": "TZ=Europe/Helsinki vitest run",
    "test:ui": "node scripts/verify.mjs",
    "icons": "node scripts/make-icons.mjs",
    "format": "prettier --write src scripts docs README.md AGENTS.md package.json vite.config.ts tsconfig.json .github",
    "format:check": "prettier --check src scripts docs README.md AGENTS.md package.json vite.config.ts tsconfig.json .github",
    "sounds": "node scripts/render-sounds.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@tanstack/react-router": "1.170.46",
    "lucide-react": "1.72.0",
    "motion": "14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
